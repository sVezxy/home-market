generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum Gender {
  ONLY_MALE
  ONLY_FEMALE
  ANY
}

enum Status {
  PENDING
  ACTIVE
  HIDDEN
  BANNED
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique @db.VarChar(100)
  passwordHash     String
  phone            String?   @unique
  telegramUsername String?   @unique
  role             Role      @default(USER)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  name             String    @db.VarChar(100)
  Listing          Listing[]
}

model Category {
  id           String    @id @default(uuid())
  typeCategory String    @unique @db.VarChar(100)
  Listing      Listing[]
}

model Listing {
  id            String    @id
  ownerId       String
  categoryId    String
  name          String    @db.VarChar(100)
  description   String
  price         Int
  deposit       Boolean
  depositAmount Int?
  street        String    @db.VarChar(100)
  streetNumber  String    @db.VarChar(20)
  amenities     String[]
  isShared      Boolean
  countPeople   Int
  countRoom     Int
  allowedGender Gender
  area          Int
  photos        String[]
  status        Status    @default(PENDING)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime
  deletedAt     DateTime?
  Category      Category  @relation(fields: [categoryId], references: [id])
  User          User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([street])
  @@index([ownerId])
  @@index([price])
}


